generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique
  permissions Json
  users       User[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model User {
  id                  String                  @id @default(uuid()) @db.Uuid
  firstName           String
  lastName            String
  email               String                  @unique
  phone               String?
  passwordHash        String
  roleId              String                  @db.Uuid
  role                Role                    @relation(fields: [roleId], references: [id])
  isActive            Boolean                 @default(true)
  lastLoginAt         DateTime?
  refreshTokenHash    String?
  driver              Driver?
  deliveries          Delivery[]              @relation("DriverDeliveries")
  statusChanges       DeliveryStatusHistory[]
  incidentsReported   Incident[]              @relation("IncidentReporter")
  incidentsResolved   Incident[]              @relation("IncidentResolver")
  maintenanceRecords  MaintenanceRecord[]     @relation("MaintenanceDriver")
  maintenanceReviewed MaintenanceRecord[]     @relation("MaintenanceReviewer")
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt

  @@index([roleId])
  @@index([isActive])
}

model Driver {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @unique @db.Uuid
  user          User     @relation(fields: [userId], references: [id])
  driverCode    String   @unique
  licenseNumber String   @unique
  truckPlate    String
  phone         String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

enum DeliveryStatus {
  CREATED
  DISPATCHED
  IN_TRANSIT
  BORDER_CHECK
  CLEARED_BORDER
  ARRIVED
  UNLOADING
  AWAITING_DELIVERY_APPROVAL
  DELIVERED
  CANCELLED
}

model Delivery {
  id                 String                  @id @default(uuid()) @db.Uuid
  deliveryNumber     String                  @unique
  driverUserId       String                  @db.Uuid
  driver             User                    @relation("DriverDeliveries", fields: [driverUserId], references: [id])
  origin             String
  destination        String
  fuelProduct        String
  quantityLiters     Decimal                 @db.Decimal(12, 2)
  truckPlate         String
  status             DeliveryStatus          @default(CREATED)
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt
  statusHistory      DeliveryStatusHistory[]
  locations          DeliveryLocation[]
  incidents          Incident[]
  maintenanceRecords MaintenanceRecord[]

  @@index([driverUserId])
  @@index([status])
  @@index([createdAt])
}

model DeliveryLocation {
  id         String   @id @default(uuid()) @db.Uuid
  deliveryId String   @db.Uuid
  delivery   Delivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  latitude   Decimal  @db.Decimal(9, 6)
  longitude  Decimal  @db.Decimal(9, 6)
  accuracy   Float?
  speed      Float?
  heading    Float?
  recordedAt DateTime
  createdAt  DateTime @default(now())

  @@index([deliveryId, recordedAt])
}

model DeliveryStatusHistory {
  id             String          @id @default(uuid()) @db.Uuid
  deliveryId     String          @db.Uuid
  delivery       Delivery        @relation(fields: [deliveryId], references: [id])
  previousStatus DeliveryStatus?
  newStatus      DeliveryStatus
  changedById    String          @db.Uuid
  changedBy      User            @relation(fields: [changedById], references: [id])
  reason         String?
  createdAt      DateTime        @default(now())

  @@index([deliveryId, createdAt])
  @@index([changedById])
}

enum IncidentType {
  BREAKDOWN
  ACCIDENT
  TIRE_PROBLEM
  FUEL_LEAK
  CUSTOMS_DELAY
  SECURITY_ISSUE
  MEDICAL_EMERGENCY
  ROUTE_BLOCKED
  OTHER
}

enum IncidentSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum IncidentStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
}

model Incident {
  id             String           @id @default(uuid()) @db.Uuid
  clientId       String?          @unique
  deliveryId     String           @db.Uuid
  delivery       Delivery         @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  reportedById   String           @db.Uuid
  reportedBy     User             @relation("IncidentReporter", fields: [reportedById], references: [id])
  type           IncidentType
  severity       IncidentSeverity
  description    String
  status         IncidentStatus   @default(OPEN)
  latitude       Decimal?         @db.Decimal(9, 6)
  longitude      Decimal?         @db.Decimal(9, 6)
  reportedAt     DateTime
  acknowledgedAt DateTime?
  resolvedAt     DateTime?
  resolvedById   String?          @db.Uuid
  resolvedBy     User?            @relation("IncidentResolver", fields: [resolvedById], references: [id])
  resolutionNote String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([deliveryId, createdAt])
  @@index([status, createdAt])
  @@index([reportedById])
}

enum MaintenanceStatus {
  PENDING
  APPROVED
  REJECTED
}

model MaintenanceRecord {
  id             String                  @id @default(uuid()) @db.Uuid
  driverUserId   String                  @db.Uuid
  driver         User                    @relation("MaintenanceDriver", fields: [driverUserId], references: [id])
  truckPlate     String
  deliveryId     String?                 @db.Uuid
  delivery       Delivery?               @relation(fields: [deliveryId], references: [id], onDelete: SetNull)
  garageName     String
  garageLocation String?
  startDate      DateTime
  endDate        DateTime
  workDone       String
  costEtb        Decimal                 @db.Decimal(12, 2)
  status         MaintenanceStatus       @default(PENDING)
  reviewNote     String?
  reviewedById   String?                 @db.Uuid
  reviewedBy     User?                   @relation("MaintenanceReviewer", fields: [reviewedById], references: [id])
  reviewedAt     DateTime?
  attachments    MaintenanceAttachment[]
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt

  @@index([driverUserId, startDate])
  @@index([status, startDate])
  @@index([startDate])
  @@index([costEtb])
}

model MaintenanceAttachment {
  id         String            @id @default(uuid()) @db.Uuid
  recordId   String            @db.Uuid
  record     MaintenanceRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)
  fileName   String
  mimeType   String
  sizeBytes  Int
  storageKey String
  createdAt  DateTime          @default(now())

  @@index([recordId])
}
