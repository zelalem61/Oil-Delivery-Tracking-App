{
  "name": "fueltrack",
  "private": true,
  "packageManager": "pnpm@10.15.1",
  "scripts": {
    "dev": "dotenv -e .env -- turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "test": "turbo test",
    "format": "prettier --write .",
    "db:generate": "dotenv -e .env -- pnpm --filter @fueltrack/api prisma:generate",
    "db:migrate": "dotenv -e .env -- pnpm --filter @fueltrack/api prisma:migrate",
    "db:seed": "dotenv -e .env -- pnpm --filter @fueltrack/api prisma:seed"
  },
  "devDependencies": {
    "dotenv-cli": "^10.0.0",
    "prettier": "^3.6.2",
    "turbo": "^2.5.6",
    "typescript": "^5.9.2"
  }
}
